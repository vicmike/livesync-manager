# Copy to .env and edit. Used by compose.yaml.

# CouchDB admin credentials (also provisions the bundled CouchDB).
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me

# The https URL DEVICES use to sync, embedded into every setup URI.
# Must be reachable from every device you will onboard.
COUCHDB_PUBLIC_URL=https://couchdb.example.com

# The app's own external URL; invite links are built from it.
PUBLIC_BASE_URL=https://livesync.example.com

# Only needed for: docker compose --profile proxy up -d
# (safe to delete otherwise)
MANAGER_DOMAIN=livesync.example.com
COUCHDB_DOMAIN=couchdb.example.com
